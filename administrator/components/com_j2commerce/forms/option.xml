<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="details">
        <field
            name="id"
            type="hidden"
            default="0"
        />

        <field
            name="option_name"
            type="text"
            label="COM_J2COMMERCE_OPTION_NAME"
            description="COM_J2COMMERCE_OPTION_NAME_DESCRIPTION"
            required="true"
            maxlength="255"
            class="form-control"
        />

        <field
            name="option_description"
            type="textarea"
            label="COM_J2COMMERCE_OPTION_DESCRIPTION"
            description="COM_J2COMMERCE_OPTION_DESCRIPTION_DESC"
            rows="3"
            filter="string"
            class="form-control"
        />

        <field
            name="option_unique_name"
            type="text"
            label="COM_J2COMMERCE_OPTION_UNIQUE_NAME"
            description="COM_J2COMMERCE_OPTION_UNIQUE_NAME_DESCRIPTION"
            maxlength="255"
            class="form-control"
            hint="COM_J2COMMERCE_OPTION_UNIQUE_NAME_HINT"
        />

        <field
            name="type"
            type="optiontype"
            addfieldprefix="J2Commerce\Component\J2commerce\Administrator\Field"
            label="COM_J2COMMERCE_OPTION_TYPE"
            description="COM_J2COMMERCE_OPTION_TYPE_DESCRIPTION"
            required="true"
            class="form-select"
            >
            <option value="">COM_J2COMMERCE_OPTION_SELECT_TYPE</option>
        </field>

        <!--
            Each showon references `type`, which lives outside this group. The leading dot is
            what escapes the group: FormHelper::parseShowOnConditions() resolves a bare name
            against the field's own group, so `type:text` would look for a non-existent
            option_params[type]. See FormHelper::parseShowOnConditions(), $dotPos === 0 branch.
        -->
        <fields name="option_params">
            <field
                name="place_holder"
                type="text"
                label="COM_J2COMMERCE_OPTION_PARAM_PLACE_HOLDER"
                description="COM_J2COMMERCE_OPTION_PARAM_PLACE_HOLDER_DESCRIPTION"
                class="form-control"
                showon=".type:text"
            />

            <field
                name="date_format_strftime"
                type="text"
                label="COM_J2COMMERCE_OPTION_PARAM_DATE_FORMAT"
                description="COM_J2COMMERCE_OPTION_PARAM_DATE_FORMAT_DESCRIPTION"
                class="form-control"
                hint="COM_J2COMMERCE_OPTION_PARAM_DATE_FORMAT_HINT"
                showon=".type:date,datetime"
            />

            <field
                name="hide_pastdates"
                type="radio"
                layout="joomla.form.field.radio.switcher"
                label="COM_J2COMMERCE_OPTION_PARAM_HIDE_PASTDATES"
                description="COM_J2COMMERCE_OPTION_PARAM_HIDE_PASTDATES_DESCRIPTION"
                filter="integer"
                default="0"
                showon=".type:date,datetime"
                >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                name="time_format"
                type="list"
                label="COM_J2COMMERCE_OPTION_PARAM_TIME_FORMAT"
                description="COM_J2COMMERCE_OPTION_PARAM_TIME_FORMAT_DESCRIPTION"
                class="form-select"
                filter="integer"
                default="24"
                showon=".type:datetime"
                >
                <option value="24">COM_J2COMMERCE_OPTION_PARAM_TIME_FORMAT_24</option>
                <option value="12">COM_J2COMMERCE_OPTION_PARAM_TIME_FORMAT_12</option>
            </field>
        </fields>
    </fieldset>

    <fieldset name="global">
        <field
            name="published"
            type="list"
            label="JSTATUS"
            description="JFIELD_PUBLISHED_DESC"
            default="1"
            class="form-select-color-state"
            >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="-2">JTRASHED</option>
        </field>

        <field
            name="ordering"
            type="ordering"
            label="JFIELD_ORDERING_LABEL"
            description="JFIELD_ORDERING_DESC"
            default="0"
            content_type="com_j2commerce.option"
        />
    </fieldset>

    <fieldset name="optionvalues" label="COM_J2COMMERCE_OPTION_VALUES">
        <field
            name="optionvalues"
            type="subform"
            label="COM_J2COMMERCE_OPTION_VALUES"
            description="COM_J2COMMERCE_OPTION_VALUES_DESC"
            layout="joomla.form.field.subform.repeatable-table"
            component="com_j2commerce"
            formsource="administrator/components/com_j2commerce/forms/optionvalue.xml"
            min="0"
            max="100"
            multiple="true"
            buttons="add,remove,move"
            showon="type:select,radio,checkbox[AND]type!:color"
            class="table table-responsive-lg"
            groupByFieldset="false"
        />
    </fieldset>

    <fieldset name="optioncolorvalues" label="COM_J2COMMERCE_OPTION_COLOR_VALUES">
        <field
            name="optioncolorvalues"
            type="subform"
            label="COM_J2COMMERCE_OPTION_COLOR_VALUES"
            description="COM_J2COMMERCE_OPTION_COLOR_VALUES_DESC"
            layout="joomla.form.field.subform.repeatable-table"
            component="com_j2commerce"
            formsource="administrator/components/com_j2commerce/forms/optioncolorvalue.xml"
            min="0"
            max="100"
            multiple="true"
            buttons="add,remove,move"
            showon="type:color"
            class="table table-responsive-lg"
            groupByFieldset="false"
        />
    </fieldset>
</form>
