<?xml version="1.0" encoding="UTF-8"?>
<metadata>
	<layout title="COM_J2COMMERCE_CONFIRMATION_VIEW_DEFAULT_TITLE" option="COM_J2COMMERCE_CONFIRMATION_VIEW_DEFAULT_OPTION">
		<message>
			<![CDATA[COM_J2COMMERCE_CONFIRMATION_VIEW_DEFAULT_DESC]]>
		</message>
	</layout>
	<fields name="request">
	</fields>
	<fields name="params">
		<fieldset name="frontend" label="COM_J2COMMERCE_LAYOUT_FRAMEWORK_FIELDSET_LABEL"
			addfieldprefix="J2Commerce\Component\J2commerce\Administrator\Field">
			<field
				name="framework"
				type="Frameworklist"
				view_context="confirmation"
				label="COM_J2COMMERCE_LAYOUT_FRAMEWORK_LABEL"
				description="COM_J2COMMERCE_LAYOUT_FRAMEWORK_DESC"
				default="bootstrap5"
			/>
		</fieldset>
		<fieldset name="tracking" label="COM_J2COMMERCE_TRACKING_FIELDSET_LABEL"
			addfieldprefix="J2Commerce\Component\J2commerce\Administrator\Field">
			<field
				name="tracking_script"
				type="Trackingscript"
				label="COM_J2COMMERCE_TRACKING_SCRIPT_LABEL"
				description="COM_J2COMMERCE_TRACKING_SCRIPT_DESC"
				rows="12"
				class="w-100"
				filter="raw"
				preview="1"
			/>

			<field
				name="tracking_script_position"
				type="list"
				label="COM_J2COMMERCE_TRACKING_POSITION_LABEL"
				description="COM_J2COMMERCE_TRACKING_POSITION_DESC"
				default="inline"
				validate="options"
			>
				<option value="inline">COM_J2COMMERCE_TRACKING_POSITION_INLINE</option>
				<option value="head">COM_J2COMMERCE_TRACKING_POSITION_HEAD</option>
			</field>

			<field
				name="tracking_script_once"
				type="radio"
				layout="joomla.form.field.radio.switcher"
				filter="integer"
				label="COM_J2COMMERCE_TRACKING_ONCE_LABEL"
				description="COM_J2COMMERCE_TRACKING_ONCE_DESC"
				default="1"
			>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
		</fieldset>
	</fields>
</metadata>
